{
  "name": "mortgage-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/compose.yml --env-file .env down",
    "infra:reset": "docker compose -f infra/compose.yml --env-file .env down -v",
    "db:migrate": "pnpm --filter @mt/api db:migrate",
    "db:deploy": "pnpm --filter @mt/api db:deploy",
    "db:seed": "pnpm --filter @mt/api db:seed",
    "db:reset": "pnpm --filter @mt/api db:reset",
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @mt/api dev\" \"pnpm --filter @mt/web dev\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test",
    "setup": "bash scripts/setup.sh",
    "prov": "node ops/provisioner/server.mjs",
    "prov:status": "curl -fsS localhost:7070/slots; echo",
    "prov:release": "f(){ curl -fsS -X POST localhost:7070/release -d \"{\\\"slot\\\":$1}\"; echo; }; f",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "db:branches": "bash scripts/db-branches.sh",
    "db:prune": "bash scripts/db-branches.sh prune"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.15.1"
}
